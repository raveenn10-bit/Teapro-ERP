{
  "name": "teapro-erp",
  "productName": "TeaPro ERP",
  "private": true,
  "version": "0.1.0",
  "description": "Offline tea estate, green leaf collection, billing, payroll and accounting ERP for Sri Lanka.",
  "author": "Harsh Apex Digital Solutions",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run test && npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3-multiple-ciphers -w argon2 -w serialport",
    "dist:win": "npm run build && npm run rebuild:native && npm run verify:release && electron-builder --win nsis --x64",
    "verify:release": "node scripts/verify-release.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "lk.com.harshapex.teapro",
    "productName": "TeaPro ERP",
    "artifactName": "TeaPro-ERP-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": ["node_modules/argon2/**/*", "node_modules/better-sqlite3-multiple-ciphers/**/*", "node_modules/@serialport/**/*", "node_modules/serialport/**/*"],
    "files": ["dist/renderer/**/*", "dist-electron/**/*", "node_modules/**/*", "package.json", "public/branding/**/*"],
    "directories": { "buildResources": "build", "output": "release" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "public/branding/teapro.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeaPro ERP",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3-multiple-ciphers": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "framer-motion": "^14.14.0",
    "i18next": "^27.1.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
